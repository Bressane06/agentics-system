DATABASE_URL=sqlite:///./agenda.db

# LLM local (Ollama). Com LLM_HABILITADO=false o sistema roda 100% deterministico.
LLM_HABILITADO=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT=30

# Loop de revisao Planejador <-> Avaliador
MAX_REVISOES=3

# Planejamento de sessoes (minutos)
SESSAO_MAX_BLOCO_MIN=120
SESSAO_MIN_BLOCO_MIN=30
HORIZONTE_MAX_DIAS=90

# Pesos da formula de prioridade (devem somar 1.0)
PESO_URGENCIA=0.40
PESO_IMPORTANCIA=0.25
PESO_DIFICULDADE=0.20
PESO_PROGRESSO=0.15
